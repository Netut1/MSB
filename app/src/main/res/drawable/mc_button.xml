<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED (вдавленная) -->
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle">
                <solid android:color="@color/mc_border"/></shape></item>
            <item android:top="1dp" android:left="1dp" android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_edge_light"/></shape></item>
            <item android:top="1dp" android:left="1dp" android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_edge_dark"/></shape></item>
            <item android:top="2dp" android:left="2dp" android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_btn_pressed"/></shape></item>
        </layer-list>
    </item>

    <!-- NORMAL -->
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <solid android:color="@color/mc_border"/></shape></item>
            <item android:top="1dp" android:left="1dp" android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_edge_dark"/></shape></item>
            <item android:top="1dp" android:left="1dp" android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_edge_light"/></shape></item>
            <item android:top="2dp" android:left="2dp" android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_btn_normal"/></shape></item>
        </layer-list>
    </item>
</selector>