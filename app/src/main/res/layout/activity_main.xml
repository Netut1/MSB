<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mc_bg">

    <!-- Верхняя панель: поиск + кнопка меню -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/mc_search_bg"
            android:hint="@string/search_hint"
            android:textColorHint="@color/mc_text_dim"
            android:textColor="@color/mc_text"
            android:textSize="14sp"
            android:fontFamily="@font/monocraft"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"/>

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/mc_button"
            android:src="@drawable/ic_menu"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="@string/cd_menu"/>
    </LinearLayout>

    <!-- Контент + сайд-панель -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/list_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mc_frame">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/mc_text"/>
        </FrameLayout>

        <!-- Сайд-панель -->
        <LinearLayout
            android:id="@+id/side_panel"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="0dp"
            android:orientation="vertical"
            android:background="@drawable/mc_frame"
            android:padding="14dp"
            android:visibility="gone"
            android:elevation="8dp">

            <TextView
                android:text="@string/mode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mc_text"
                android:textSize="13sp"
                android:fontFamily="@font/monocraft"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/mode_normal"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/mode_normal"
                    android:textSize="12sp"
                    android:fontFamily="@font/monocraft"
                    android:textColor="@drawable/mc_toggle_text"
                    android:background="@drawable/mc_button"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/mode_repeat"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/mode_repeat"
                    android:textSize="12sp"
                    android:fontFamily="@font/monocraft"
                    android:textColor="@drawable/mc_toggle_text"
                    android:background="@drawable/mc_button"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/mode_all"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/mode_all"
                    android:textSize="12sp"
                    android:fontFamily="@font/monocraft"
                    android:textColor="@drawable/mc_toggle_text"
                    android:background="@drawable/mc_button"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:text="@string/speed_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/mc_text"
                android:textSize="13sp"
                android:fontFamily="@font/monocraft"/>

            <LinearLayout
                android:id="@+id/speed_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"/>

            <TextView
                android:text="@string/sync_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/mc_text"
                android:textSize="13sp"
                android:fontFamily="@font/monocraft"/>

            <TextView
                android:id="@+id/btn_sync"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/sync_github"
                android:textColor="@color/mc_text"
                android:textSize="13sp"
                android:fontFamily="@font/monocraft"
                android:background="@drawable/mc_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sync_assets"
                android:textColor="@color/mc_text_dim"
                android:textSize="11sp"
                android:fontFamily="@font/monocraft"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Нижняя панель плеера -->
    <LinearLayout
        android:id="@+id/player_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/mc_panel">

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/mc_button"
            android:src="@drawable/ic_stop"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="@string/cd_stop"/>

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/mc_button"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/cd_play"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/track_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_track"
                android:textColor="@color/mc_text"
                android:textSize="13sp"
                android:fontFamily="@font/monocraft"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/mc_green"
                android:progressBackgroundTint="@color/mc_edge_dark"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>